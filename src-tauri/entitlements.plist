<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
      Apple Events: Camu asks an app to quit before replacing it, the same
      way the Dock's Quit does, so the app can save its work. macOS asks the
      user once per app before allowing it.
    -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
    <!--
      Entitlements for the hardened runtime, which notarization requires.
      Add only what the app needs. Common additions:

        com.apple.security.network.client       outbound network
        com.apple.security.files.user-selected.read-write
                                                  files the user picks
        com.apple.security.app-sandbox          Mac App Store builds

      The app is not sandboxed by default: a sandbox is required for the Mac
      App Store and gets in the way for apps distributed as a .dmg.
    -->
</dict>
</plist>
